PORT=5000
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/aura
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
NODE_ENV=development

# Optional WebRTC STUN/TURN configuration. JSON array, provided to authenticated call clients.
# Production calls across mobile/carrier networks should use a TURN relay.
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-relay.example:3478","username":"replace-me","credential":"replace-me"}]
