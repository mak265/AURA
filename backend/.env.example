PORT=5000
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/aura
JWT_SECRET=replace-with-a-long-random-secret
# Keep this separate from JWT_SECRET and stable after Superadmin MFA enrollment.
MFA_ENCRYPTION_KEY=
# Set only to trusted reverse proxy addresses/CIDRs if the API is behind one.
TRUSTED_PROXY_CIDRS=
GOOGLE_CLIENT_ID=
NODE_ENV=development

# Android push uses Firebase HTTP v1 and Application Default Credentials.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# iOS push uses the Apple Team ID, APNs Key ID, and a private .p8 file on the server.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.aura.dating
APNS_ENV=sandbox

# Optional WebRTC STUN/TURN configuration. JSON array, provided to authenticated call clients.
# Production calls across mobile/carrier networks should use a TURN relay.
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-relay.example:3478","username":"replace-me","credential":"replace-me"}]
